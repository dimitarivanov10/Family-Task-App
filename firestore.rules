rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Family/task access additionally requires a verified email address
    // (see users/{uid} below, which stays open to unverified accounts so
    // onboarding and the verify-email screen keep working).
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Single-document membership check (used by `get`/`create`/`update`
    // requests, never by a `list` query — get()-based rules can't be
    // validated against a query's filters, see the comment on
    // /families/{familyId} below).
    function isFamilyMember(familyId) {
      return isVerified()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // Used only for history reads, which list a fixed, already-known
    // subcollection path (no query filter to correlate), so a get() on
    // the fixed parent task is fine here the same way isFamilyMember's
    // get() on the fixed parent family is fine for tasks.
    function isTaskViewer(familyId, taskId) {
      let task = get(/databases/$(database)/documents/families/$(familyId)/tasks/$(taskId)).data;
      return isFamilyMember(familyId)
        && (request.auth.uid in task.assignees || request.auth.uid == task.createdBy);
    }

    // Verifies the task write this is attached to is paired, in the same
    // batch, with a new history doc matching the caller and the server
    // time — see the /history/{eventId} rule below for the other half.
    function historyPairingValid(familyId, taskId) {
      let historyId = request.resource.data.lastHistoryEventId;
      let historyPath = /databases/$(database)/documents/families/$(familyId)/tasks/$(taskId)/history/$(historyId);
      return existsAfter(historyPath)
        && getAfter(historyPath).data.byUid == request.auth.uid
        && getAfter(historyPath).data.at == request.time;
    }

    // Firestore rules only allow top-level function/match declarations
    // (no top-level const), so these are functions instead.
    function taskStatusFields() {
      return [
        'status', 'nextReminderAt', 'remindersSent',
        'declineReason', 'declinedBy', 'lastHistoryEventId'
      ];
    }
    function historyEventTypes() {
      return [
        'created', 'seen', 'accepted', 'status_changed', 'declined',
        'deadline_proposed', 'deadline_accepted',
        'verified', 'archived', 'cancelled'
      ];
    }

    // User profile: only the owner can read/write their own profile,
    // including the familyIds pointer list used to find their families
    // (see /families/{familyId} below for why this replaced a list query).
    // Intentionally not gated on isVerified() — an unverified user still
    // needs to read/write their own profile for the verify-email screen
    // and resend flow to work before they can use any family/task data.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      // FCM device tokens: not tamper-sensitive, owner manages directly.
      match /devices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /families/{familyId} {
      // The family document's own auto-generated id is the "invite code"
      // (no separate inviteCode field, no lookup query). Clients only ever
      // `get` a family by a known id (from users/{uid}.familyIds, or a code
      // someone shared) — never `list` the collection, so this rule only
      // has to hold for single-document reads. It's still written against
      // resource.data directly (not a self-referential get()) so it would
      // also survive being used in a query, since Firestore can only grant
      // a list/query request when the rule is provably tied to the
      // query's own filter — a get()-based rule isn't, and gets denied
      // outright even when every individual document would pass.
      allow read: if isVerified() && request.auth.uid in resource.data.members;

      allow create: if isVerified()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Join: add exactly the caller's own uid to members (and their own
      // entry to memberNames), nothing else.
      allow update: if isVerified()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]);

      // Leave: remove exactly the caller's own uid from members, nothing
      // else. memberNames is left untouched so old tasks/history still
      // show a former member's name instead of a bare uid.
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.members)
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      allow delete: if false;

      match /tasks/{taskId} {
        // Only the creator and the assignees can see a task at all —
        // written against resource.data directly (no get()) so it stays
        // valid for the client's list query, which filters with a
        // matching OR of assignees-array-contains/createdBy-equals.
        allow read: if isFamilyMember(familyId)
          && (request.auth.uid in resource.data.assignees || request.auth.uid == resource.data.createdBy);

        allow create: if isVerified()
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'pending'
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.assignees is list && request.resource.data.assignees.size() > 0
          && request.resource.data.deadline is timestamp
          && historyPairingValid(familyId, taskId)
          && getAfter(/databases/$(database)/documents/families/$(familyId)/tasks/$(taskId)/history/$(request.resource.data.lastHistoryEventId)).data.type == 'created';

        // Immutable once created except for a fixed set of mutable
        // "status fields". An assignee may move the task through
        // seen/accepted/done/declined; the creator may additionally
        // reopen a done or declined task. "verified"/"archived"/
        // "cancelled" are excluded here — those go through their own
        // narrower clauses below. Every update must be paired, in the
        // same batch, with a new history entry pointing back at this
        // exact write (see history/{eventId} below).
        allow update: if isVerified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(taskStatusFields())
          && !(request.resource.data.status in ['verified', 'archived', 'cancelled'])
          && (
            (request.auth.uid in resource.data.assignees)
            || (request.auth.uid == resource.data.createdBy
                && resource.data.status in ['done', 'declined']
                && !(request.resource.data.status in ['done', 'declined']))
          )
          && historyPairingValid(familyId, taskId);

        // Propose a new deadline: either the creator or an assignee may
        // propose, but only while there's no proposal already pending,
        // and the proposedBy must be the caller themself.
        allow update: if isVerified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposedDeadline', 'proposedBy', 'lastHistoryEventId'])
          && (request.auth.uid in resource.data.assignees || request.auth.uid == resource.data.createdBy)
          && resource.data.proposedDeadline == null
          && request.resource.data.proposedBy == request.auth.uid
          && !(resource.data.status in ['done', 'declined', 'verified', 'archived', 'cancelled'])
          && historyPairingValid(familyId, taskId);

        // Accept a pending deadline proposal: only the other party may
        // confirm it — never the proposer. If the creator proposed, an
        // assignee must confirm; if an assignee proposed, the creator
        // must confirm.
        allow update: if isVerified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['effectiveDeadline', 'proposedDeadline', 'proposedBy', 'lastHistoryEventId'])
          && resource.data.proposedDeadline != null
          && request.resource.data.effectiveDeadline == resource.data.proposedDeadline
          && request.resource.data.proposedDeadline == null
          && request.resource.data.proposedBy == null
          && request.auth.uid != resource.data.proposedBy
          && (
            (resource.data.proposedBy == resource.data.createdBy && request.auth.uid in resource.data.assignees)
            || (resource.data.proposedBy != resource.data.createdBy && request.auth.uid == resource.data.createdBy)
          )
          && historyPairingValid(familyId, taskId);

        // Verify: only the creator, and only once the assignee has
        // marked it done — this is the "the one who gave the task
        // checks it" review step, so an assignee can never verify their
        // own completed work.
        allow update: if isVerified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedAt', 'verifiedBy', 'lastHistoryEventId'])
          && request.auth.uid == resource.data.createdBy
          && resource.data.status == 'done'
          && request.resource.data.status == 'verified'
          && request.resource.data.verifiedBy == request.auth.uid
          && request.resource.data.verifiedAt == request.time
          && historyPairingValid(familyId, taskId);

        // Archive: a mechanical cleanup step once verified, not a
        // judgment call, so either party may trigger it (the client
        // does so automatically a few days after verification).
        allow update: if isVerified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'archivedAt', 'lastHistoryEventId'])
          && (request.auth.uid in resource.data.assignees || request.auth.uid == resource.data.createdBy)
          && resource.data.status == 'verified'
          && request.resource.data.status == 'archived'
          && request.resource.data.archivedAt == request.time
          && historyPairingValid(familyId, taskId);

        // Cancel: creator-only soft delete. The task and its full
        // history stay in Firestore forever — this only marks it
        // cancelled and takes it off the active board. Only makes sense
        // before real work was done, not for a task already done.
        allow update: if isVerified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelReason', 'lastHistoryEventId'])
          && request.auth.uid == resource.data.createdBy
          && resource.data.status in ['pending', 'seen', 'accepted', 'declined']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && historyPairingValid(familyId, taskId);

        allow delete: if false;

        // Append-only audit log. A history doc can only be created
        // alongside (in the same batch as) the task write it documents —
        // enforced from both sides: the task write rules above require
        // this doc to exist-after with matching byUid/at, and this rule
        // requires the task's after-state to point back at this exact
        // document id.
        match /history/{eventId} {
          allow read: if isTaskViewer(familyId, taskId);

          allow create: if isVerified()
            && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members
            && request.resource.data.byUid == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.type in historyEventTypes()
            && getAfter(/databases/$(database)/documents/families/$(familyId)/tasks/$(taskId)).data.lastHistoryEventId == eventId;

          allow update, delete: if false;
        }
      }
    }
  }
}
