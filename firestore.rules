rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // User profile: only the owner can read/write their own profile.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      // FCM device tokens: not tamper-sensitive, owner manages directly.
      match /devices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Families: created/joined only through Cloud Functions (Admin SDK),
    // so invite codes and membership can be validated server-side.
    match /families/{familyId} {
      // Read directly off resource.data rather than isFamilyMember()'s
      // self-referential get() — Firestore can only validate a list/query
      // request against a rule it can tie to the query itself, and a
      // get()-based rule isn't, so any list query against this collection
      // (e.g. an array-contains membership lookup) would be denied outright
      // even though every per-document check would pass. The client reads
      // this doc by a known id (via users/{uid}.familyId) rather than
      // querying, but this form keeps that read valid under either access
      // pattern.
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow write: if false;

      // Tasks: create/update/delete only through Cloud Functions so every
      // mutation is paired with a server-timestamped history entry.
      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;

        // Append-only audit log. Never writable from the client.
        match /history/{eventId} {
          allow read: if isFamilyMember(familyId);
          allow write: if false;
        }
      }
    }
  }
}
